# Required for POST /api/health/guidance
OPENAI_API_KEY=replace_with_your_openai_api_key

# Optional OpenAI-compatible API settings
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Allowed frontend origin; defaults to http://localhost:5173
NIVORA_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173

# Optional server port (defaults to 8080)
PORT=8080

# Optional MySQL profile configuration. Set SPRING_PROFILES_ACTIVE=mysql to use it.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://localhost:3306/nivora?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=replace_with_your_database_username
DB_PASSWORD=replace_with_your_database_password
